<Window x:Class="PAMP.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAMP"
        mc:Ignorable="d"
        Title="{local:Loc settingsTtile}" Width="500" Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/pamp_icon.ico">
    <Window.Resources>
        <Style x:Key="FluentSettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,12"/>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,7,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0"
                                                  ContentSource="Header"
                                                  Margin="0,0,0,6"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border x:Name="ActiveIndicator"
                                        Grid.Row="1"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="2,0,2,0"
                                        Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Style="{StaticResource FluentSettingsTabControlStyle}"
                    ItemContainerStyle="{StaticResource FluentSettingsTabItemStyle}">
            <!-- Karta 1: Ogólne (Język interfejsu) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc settingsTabGeneral}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🌐" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc settingsLanguageHeader}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{local:Loc settingsLanguageSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <ComboBox x:Name="CmbLanguage" Height="34" VerticalContentAlignment="Center" FontSize="13" SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Tag="pl" Padding="6,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="PL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="Polski" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="en" Padding="6,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="EN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="English" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="uk" Padding="6,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="UK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="Українська" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <!-- Karta 2: Zasobnik systemowy -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📌" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc settingsTabTray}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📌" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc settingsTrayHeader}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkMinimizeToTray"
                              Content="{local:Loc settingsMinimizeToTray}"
                              FontSize="12.5"
                              Margin="0,2,0,10"
                              Checked="ChkMinimizeToTray_Changed"
                              Unchecked="ChkMinimizeToTray_Changed"/>

                    <CheckBox x:Name="ChkCloseToTray"
                              Content="{local:Loc settingsCloseToTray}"
                              FontSize="12.5"
                              Margin="0,0,0,8"
                              Checked="ChkCloseToTray_Changed"
                              Unchecked="ChkCloseToTray_Changed"/>

                    <CheckBox x:Name="ChkShowTrayNotification"
                              Content="{local:Loc settingsShowTrayNotification}"
                              FontSize="12"
                              Margin="24,2,0,6"
                              Checked="ChkShowTrayNotification_Changed"
                              Unchecked="ChkShowTrayNotification_Changed"/>
                </StackPanel>
            </TabItem>

            <!-- Karta 3: Aktualizacje programu -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Loc settingsTabUpdates}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Loc settingsUpdatesHeader}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="7,2" CornerRadius="4" Background="#15808080">
                            <TextBlock x:Name="TxtCurrentAppVersion" Text="v1.4.1-beta1"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <CheckBox x:Name="ChkAutoCheckUpdates"
                              Content="{local:Loc settingsAutoCheckUpdates}"
                              FontSize="12.5"
                              Margin="0,2,0,10"
                              Checked="ChkAutoCheckUpdates_Changed"
                              Unchecked="ChkAutoCheckUpdates_Changed"/>

                    <CheckBox x:Name="ChkIncludeBetaUpdates"
                              Content="{local:Loc settingsIncludeBetaUpdates}"
                              FontSize="12.5"
                              Margin="0,0,0,16"
                              Checked="ChkIncludeBetaUpdates_Changed"
                              Unchecked="ChkIncludeBetaUpdates_Changed"/>

                    <Button x:Name="BtnCheckUpdatesNow"
                            Content="{local:Loc settingsCheckUpdatesNow}"
                            Height="32"
                            Padding="14,0"
                            HorizontalAlignment="Left"
                            Click="BtnCheckUpdatesNow_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1"
                Content="{local:Loc settingsOkBtn}"
                Height="32" Width="96"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True"
                Click="BtnClose_Click"/>
    </Grid>
</Window>
