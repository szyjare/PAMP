<Window x:Class="PAMP.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAMP"
        mc:Ignorable="d"
        Title="Settings" Height="450" Width="800">
    <Grid>
        <GroupBox Margin="10,10,10,10" FontSize="16" FontWeight="Bold"
                  Background="Transparent" BorderBrush="LightGray" BorderThickness="2">
            <GroupBox.Header>
                Language
            </GroupBox.Header>

            <TextBlock FontSize="12" FontWeight="Regular">
                ...
            </TextBlock>
        </GroupBox>
    </Grid>
</Window>
