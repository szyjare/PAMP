<Window x:Class="PAMP.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAMP"
        mc:Ignorable="d"
        Title="{local:Loc settingsTtile}" Height="200" Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="1" Margin="10,10,10,10" FontSize="14"
                  Background="Transparent" BorderBrush="LightGray" BorderThickness="2">
            <GroupBox.Header>
                <TextBlock Text="{local:Loc settingsLanguageHeader}"/>
            </GroupBox.Header>

            <StackPanel Orientation="Vertical">
                <RadioButton x:Name="RadioEN" Checked="Language_Checked" GroupName="Language" Tag="en" Content="English" Margin="10,5,10,5"/>
                <RadioButton x:Name="RadioPL" Checked="Language_Checked" GroupName="Language" Tag="pl" Content="Polski" Margin="10,5,10,5"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
