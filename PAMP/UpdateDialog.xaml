<Window x:Class="PAMP.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAMP"
        mc:Ignorable="d"
        Title="{local:Loc updateTitle}" Height="500" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/pamp_icon.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{local:Loc updateNewVersionAvailable}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="{local:Loc updateCurrentVersion}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Padding="6,2" CornerRadius="4" Background="#15808080" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtCurrentVersion" Text="v1.2.1" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="➔" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBlock Text="{local:Loc updateLatestVersion}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Padding="6,2" CornerRadius="4" Background="#25107C41">
                    <TextBlock x:Name="TxtNewVersion" Text="v1.3.0" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Karta dziennika zmian (Changelog) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{local:Loc updateChangelog}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtChangelog" 
                             IsReadOnly="True" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             Foreground="{DynamicResource TextPrimaryBrush}" 
                             TextWrapping="Wrap" 
                             FontFamily="Segoe UI" 
                             FontSize="12" 
                             Cursor="Arrow"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pasek postępu pobierania -->
        <StackPanel x:Name="PanelProgress" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtProgressStatus" Text="{local:Loc updateDownloading}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <ProgressBar x:Name="ProgressBarUpdate" Height="8" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
        </StackPanel>

        <!-- Dolny pasek przycisków -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                <Hyperlink x:Name="LinkGithubRelease" RequestNavigate="LinkGithubRelease_RequestNavigate">
                    <TextBlock Text="{local:Loc updateViewOnGithub}" FontSize="11"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSkip" Content="{local:Loc updateBtnSkip}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnSkip_Click"/>
                <Button x:Name="BtnLater" Content="{local:Loc updateBtnLater}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnLater_Click"/>
                <Button x:Name="BtnInstall" Content="{local:Loc updateBtnInstall}" Height="32" Padding="16,0" FontWeight="SemiBold" Click="BtnInstall_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
