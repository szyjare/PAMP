<Window x:Class="PAMP.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PAMP"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{local:Loc aboutTitle}" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Image HorizontalAlignment="Center" Height="85" VerticalAlignment="Top" Width="190" Source="/pamp_logo_min.png" Stretch="Uniform" Margin="0,15,0,0"/>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Personal Apache MariaDB PHP" VerticalAlignment="Top" Margin="0,105,0,0" FontWeight="SemiBold"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,126,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="{local:Loc version}"/>
            <Run x:Name="RunAboutVersionNumber"/>
        </TextBlock>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16" VerticalAlignment="Bottom">
            <TextBlock Text="© 2026 Szymon Jarecki. Open Source License (MIT)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                <Hyperlink NavigateUri="https://github.com/szyjare/PAMP" RequestNavigate="Hyperlink_RequestNavigate">
                    <TextBlock Text="{local:Loc aboutVisitGithub}" FontSize="11"/>
                </Hyperlink>
            </TextBlock>

            <Button Content="{local:Loc aboutOkBtn}" Width="90" Height="32" Margin="0,12,0,0" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
