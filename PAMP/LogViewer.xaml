<Window x:Class="PAMP.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PAMP"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc logsTitle}" Height="680" Width="880"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasek narzędziowy (2 rzędy) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rząd 1: Filtry (Plik logu, Poziom logów, Wyszukiwarka) -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{local:Loc logsSelectFile}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboLogFiles" Width="220" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogFiles_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBox x:Name="ComboLogLevelFilter" Width="170" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogLevelFilter_SelectionChanged">
                        <ComboBoxItem Content="{local:Loc logsFilterAll}" Tag="all"/>
                        <ComboBoxItem Content="{local:Loc logsFilterWarnErrors}" Tag="warn_error"/>
                        <ComboBoxItem Content="{local:Loc logsFilterErrors}" Tag="error"/>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TxtSearchFilter" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtSearchFilter_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="{local:Loc logsSearchPrompt}" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Visible"/>
                </Grid>
            </Grid>

            <!-- Rząd 2: Akcje i opcje (Autoprzewijanie, Wyczyść widok, Otwórz w edytorze, Odśwież teraz) -->
            <DockPanel Grid.Row="1">
                <CheckBox x:Name="ChkAutoScroll" Content="{local:Loc logsAutoscroll}" IsChecked="True" VerticalAlignment="Center" DockPanel.Dock="Left" Checked="ChkAutoScroll_Checked"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnClearView" Content="{local:Loc logsClearView}" Height="32" Click="BtnClearView_Click" Margin="0,0,6,0" Padding="12,0"/>
                    <Button x:Name="BtnOpenInEditor" Content="{local:Loc logsOpenInEditor}" Height="32" Click="BtnOpenInEditor_Click" Margin="0,0,6,0" Padding="12,0"/>
                    <Button Content="{local:Loc logsRefreshNow}" Height="32" Click="BtnRefresh_Click" Padding="14,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Zawartość logów -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <RichTextBox x:Name="RtbLogContent"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         Padding="0"
                         VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace"
                         FontSize="12">
                <RichTextBox.Resources>
                    <Style x:Key="LogScrollBarPageButton" TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="LogScrollBarThumb" TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbVisual"
                                            Background="#60808080"
                                            CornerRadius="4"
                                            Margin="3,0"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbVisual" Property="Background" Value="#95808080"/>
                                            <Setter TargetName="ThumbVisual" Property="Margin" Value="2,0"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbVisual" Property="Background" Value="#C0808080"/>
                                            <Setter TargetName="ThumbVisual" Property="Margin" Value="2,0"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ScrollBar">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="MinWidth" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent" Margin="0,4">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource LogScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource LogScrollBarThumb}"/>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource LogScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument x:Name="DocLogs" PagePadding="10,8,10,8" FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" FontSize="12">
                </FlowDocument>
            </RichTextBox>
        </Border>

        <!-- Pasek statusu -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="TxtLogStatus" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" DockPanel.Dock="Left"/>
            <TextBlock x:Name="TxtLineCount" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
