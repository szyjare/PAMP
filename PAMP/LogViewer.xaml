<Window x:Class="PAMP.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PAMP"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc logsTitle}" Height="680" Width="880"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasek narzędziowy (2 rzędy) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rząd 1: Filtry (Plik logu, Poziom logów, Wyszukiwarka) -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{local:Loc logsSelectFile}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboLogFiles" Width="220" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogFiles_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBox x:Name="ComboLogLevelFilter" Width="170" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogLevelFilter_SelectionChanged">
                        <ComboBoxItem Content="{local:Loc logsFilterAll}" Tag="all"/>
                        <ComboBoxItem Content="{local:Loc logsFilterWarnErrors}" Tag="warn_error"/>
                        <ComboBoxItem Content="{local:Loc logsFilterErrors}" Tag="error"/>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TxtSearchFilter" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtSearchFilter_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="{local:Loc logsSearchPrompt}" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Visible"/>
                </Grid>
            </Grid>

            <!-- Rząd 2: Akcje i opcje (Autoprzewijanie, Wyczyść widok, Otwórz w edytorze, Odśwież teraz) -->
            <DockPanel Grid.Row="1">
                <CheckBox x:Name="ChkAutoScroll" Content="{local:Loc logsAutoscroll}" IsChecked="True" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnClearView" Content="{local:Loc logsClearView}" Height="32" Click="BtnClearView_Click" Margin="0,0,6,0" Padding="12,0"/>
                    <Button x:Name="BtnOpenInEditor" Content="{local:Loc logsOpenInEditor}" Height="32" Click="BtnOpenInEditor_Click" Margin="0,0,6,0" Padding="12,0"/>
                    <Button Content="{local:Loc logsRefreshNow}" Height="32" Click="BtnRefresh_Click" Padding="14,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Zawartość logów -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
            <RichTextBox x:Name="RtbLogContent"
                         IsReadOnly="True" 
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         Padding="10"
                         VerticalScrollBarVisibility="Visible" 
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" 
                         FontSize="12">
                <FlowDocument x:Name="DocLogs" FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" FontSize="12">
                </FlowDocument>
            </RichTextBox>
        </Border>

        <!-- Pasek statusu -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="TxtLogStatus" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" DockPanel.Dock="Left"/>
            <TextBlock x:Name="TxtLineCount" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
