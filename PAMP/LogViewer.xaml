<Window x:Class="PAMP.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PAMP"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc logsTitle}" Height="700" Width="1180"
        MinHeight="480" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasek narzędziowy -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- Akcje po prawej stronie (zadokowane najpierw, gwarantujące stałą widoczność) -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ChkAutoScroll" Content="{local:Loc logsAutoscroll}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnClearView" Content="{local:Loc logsClearView}" Height="32" Click="BtnClearView_Click" Margin="0,0,6,0" Padding="10,0"/>
                <Button x:Name="BtnOpenInEditor" Content="{local:Loc logsOpenInEditor}" Height="32" Click="BtnOpenInEditor_Click" Margin="0,0,6,0" Padding="10,0"/>
                <Button Content="{local:Loc logsRefreshNow}" Height="32" Click="BtnRefresh_Click" Padding="12,0"/>
            </StackPanel>

            <!-- Filtry po lewej stronie -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{local:Loc logsSelectFile}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ComboLogFiles" Width="195" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogFiles_SelectionChanged"/>

                <ComboBox x:Name="ComboLogLevelFilter" Width="145" Height="32" VerticalContentAlignment="Center" Margin="8,0,0,0" SelectionChanged="ComboLogLevelFilter_SelectionChanged">
                    <ComboBoxItem Content="{local:Loc logsFilterAll}" Tag="all"/>
                    <ComboBoxItem Content="{local:Loc logsFilterWarnErrors}" Tag="warn_error"/>
                    <ComboBoxItem Content="{local:Loc logsFilterErrors}" Tag="error"/>
                </ComboBox>

                <Grid Margin="8,0,0,0">
                    <TextBox x:Name="TxtSearchFilter" Width="160" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtSearchFilter_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="{local:Loc logsSearchPrompt}" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Visible"/>
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- Zawartość logów -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
            <RichTextBox x:Name="RtbLogContent"
                         IsReadOnly="True" 
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         Padding="10"
                         VerticalScrollBarVisibility="Visible" 
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" 
                         FontSize="12">
                <FlowDocument x:Name="DocLogs" FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" FontSize="12">
                </FlowDocument>
            </RichTextBox>
        </Border>

        <!-- Pasek statusu -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="TxtLogStatus" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" DockPanel.Dock="Left"/>
            <TextBlock x:Name="TxtLineCount" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
