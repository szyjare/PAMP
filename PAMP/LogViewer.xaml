<Window x:Class="PAMP.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PAMP"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc logsTitle}" Height="600" Width="800"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{local:Loc logsSelectFile}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ComboLogFiles" Width="220" Height="32" VerticalContentAlignment="Center" SelectionChanged="ComboLogFiles_SelectionChanged"/>
            <CheckBox x:Name="ChkAutoScroll" Content="{local:Loc logsAutoscroll}" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Content="{local:Loc logsRefreshNow}" Height="32" Click="BtnRefresh_Click" Margin="20,0,0,0" Padding="14,0"/>
        </StackPanel>

        <RichTextBox x:Name="RtbLogContent" Grid.Row="1" 
             IsReadOnly="True" 
             Background="{DynamicResource CardBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             BorderBrush="{DynamicResource CardBorderBrush}"
             BorderThickness="1"
             Padding="10"
             VerticalScrollBarVisibility="Visible" 
             HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" 
             FontSize="12.5">
            <FlowDocument FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" FontSize="12.5">
                <Paragraph x:Name="LogParagraph" FontFamily="Consolas, Cascadia Mono, Lucida Console, monospace" FontSize="12.5">
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>