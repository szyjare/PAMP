<Window x:Class="PAMP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PAMP"
        mc:Ignorable="d"
        Title="PAMP Launcher" Height="410" Width="580" 
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/pamp_icon.ico">

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Menu zintegrowane z tłem Mica -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2">
            <Menu Background="Transparent" Padding="6,4">
                <MenuItem Header="{local:Loc mnuLogs}" Click="BtnShowLogs_Click"/>
                <MenuItem Header="{local:Loc mnuTools}">
                    <MenuItem Header="{local:Loc mnuToolsSQL}" Click="BtnOpenSqlShell_Click"/>
                    <MenuItem Header="{local:Loc mnuToolsLocalhost}" Click="BtnOpenLocalhost_Click"/>
                    <MenuItem Header="{local:Loc mnuToolsPMA}" Click="BtnOpenPma_Click"/>
                    <MenuItem Header="{local:Loc mnuToolsWWW}" Click="BtnOpenFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="{local:Loc mnuToolsComponents}" FontWeight="Medium" Click="BtnShowComponents_Click"/>
                    <Separator/>
                    <MenuItem Header="{local:Loc mnuToolsWipe}" FontWeight="SemiBold" Click="BtnFactoryReset_Click"/>
                </MenuItem>
                <MenuItem Header="{local:Loc mnuSettings}" Click="BtnShowSettings_Click"/>
                <MenuItem Header="{local:Loc mnuHelp}">
                    <MenuItem Header="{local:Loc mnuHelpAbout}" Click="BtnShowAbout_Click"/>
                </MenuItem>
                <MenuItem Header="{local:Loc mnuExit}" Click="Exit_Click"/>
            </Menu>
        </DockPanel>

        <!-- Nagłówek: Logo oraz wersja PAMP -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4">
            <Image Height="85" Width="190" Source="/pamp_logo_min.png" Stretch="Uniform" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtPampVersion" Text="{local:Loc version}" 
                       FontSize="13" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Przyciski szybkich akcji (Prawa kolumna - Góra) -->
        <Border Grid.Row="1" Grid.Column="1" Margin="6,4,12,4" Padding="8" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                RenderOptions.BitmapScalingMode="HighQuality">
            <StackPanel VerticalAlignment="Center">
                <Button Height="30" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Click="BtnOpenLocalhost_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Height="18" Width="18" Source="/Resources/localhost.png" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{local:Loc btnLocalhost}"/>
                    </StackPanel>
                </Button>
                <Button Height="30" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Click="BtnOpenPma_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Height="18" Width="18" Source="/Resources/pma.png" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{local:Loc btnPMA}"/>
                    </StackPanel>
                </Button>
                <Button Height="30" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Click="BtnOpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Height="18" Width="18" Source="/Resources/www_dir.png" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{local:Loc btnWWW}"/>
                    </StackPanel>
                </Button>
                <Button Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Click="BtnOpenSqlShell_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Height="18" Width="18" Source="/Resources/sql_shell.png" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{local:Loc btnSQL}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Karta Statusu Serwerów (Lewa kolumna - Dół) -->
        <Border Grid.Row="2" Grid.Column="0" Margin="12,6,6,4" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                RenderOptions.BitmapScalingMode="HighQuality">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nagłówki tabeli -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{local:Loc modulesModule}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{local:Loc modulesPort}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Wiersz Apache -->
                <Image x:Name="ApacheStatusIcon" Grid.Row="1" Grid.Column="0" Width="18" Height="18" Source="/Resources/off.png" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{local:Loc apache}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock x:Name="apachePortBlock" Grid.Row="1" Grid.Column="2" Text="..." FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6"/>
                <Button x:Name="apacheBtn" Grid.Row="1" Grid.Column="3" Content="{local:Loc start}" Width="80" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="apache" Click="BtnToggleServer_Click" Margin="0,4"/>

                <!-- Wiersz MariaDB -->
                <Image x:Name="DbStatusIcon" Grid.Row="2" Grid.Column="0" Width="18" Height="18" Source="/Resources/off.png" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{local:Loc mariadb}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock x:Name="dbPortBlock" Grid.Row="2" Grid.Column="2" Text="..." FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6"/>
                <Button x:Name="mysqlBtn" Grid.Row="2" Grid.Column="3" Content="{local:Loc start}" Width="80" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="mysql" Click="BtnToggleServer_Click" Margin="0,4"/>
            </Grid>
        </Border>

        <!-- Karta Wersji Komponentów (Prawa kolumna - Dół) -->
        <Border Grid.Row="2" Grid.Column="1" Margin="6,6,12,4" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc apache}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc mariadb}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc pma}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Loc php}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>

                <TextBlock x:Name="TxtApacheVersion" Grid.Row="0" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,4"/>
                <TextBlock x:Name="TxtMariaDbVersion" Grid.Row="1" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,4"/>
                <TextBlock x:Name="TxtPMAVersion" Grid.Row="2" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,4"/>
                <TextBlock x:Name="TxtPhpVersion" Grid.Row="3" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>